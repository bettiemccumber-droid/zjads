DATABASE_URL="mysql://zjads:zjads@localhost:3306/zjads"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev-change-this-secret-in-production"
JWT_EXPIRES_IN="7d"
CREDENTIALS_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
PORT=3000

# 月度结算报表 USD→CNY 展示汇率（非实时）
SETTLEMENT_USD_CNY_RATE=7.25

# 结算报表佣金矩阵列顺序（联盟序号 alias，逗号分隔）
# SETTLEMENT_ALIAS_ORDER=rw1,rw2,lh,cg,lb1,lb2,pm

# 定时联盟订单采集（试点，默认关闭）
# SCHEDULED_SYNC_ENABLED=true
# SCHEDULED_SYNC_LOOKBACK_DAYS=30
# SCHEDULED_SYNC_INCLUDE_CLICKS=false
# 每天 06:10 上海时间（代码内 Cron，改时间需改 sync-scheduler.service.ts）
