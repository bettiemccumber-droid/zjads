// ZJADS — MySQL schema（单一事实来源，见 docs/TECHNICAL.md）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum NormalizedStatus {
  approved
  pending
  rejected
  unknown
}

enum SyncJobStatus {
  pending
  running
  completed
  failed
  partial
}

enum AffiliateClickSource {
  api
  manual
}

enum SyncJobItemStatus {
  pending
  running
  completed
  failed
}

enum CommissionAlertStatus {
  open
  ack
  superseded
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("organizations")
}

model User {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  username       String   @db.VarChar(100)
  role           UserRole @default(OPERATOR)
  isActive       Boolean  @default(true) @map("is_active")
  /** 所属组长（可空；仅员工账号使用） */
  reportsToId    Int?     @map("reports_to_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id])
  reportsTo            User?                 @relation("UserTeam", fields: [reportsToId], references: [id], onDelete: SetNull)
  teamMembers          User[]                @relation("UserTeam")
  channelAccounts       ChannelAccount[]
  syncJobs              SyncJob[]
  adDataSources         AdDataSource[]
  commissionAlertRule   CommissionAlertRule?
  commissionAlerts      CommissionAlert[]
  publishSites          PublishSite[]
  paymentMethods        PaymentMethod[]
  catalogMerchants      CatalogMerchant[]
  googleAdsConnections  GoogleAdsConnection[]
  adJobs                AdJob[]
  adAutomationCampaigns AdAutomationCampaign[]

  @@index([organizationId])
  @@index([reportsToId])
  @@map("users")
}

model Platform {
  id               Int      @id @default(autoincrement())
  code             String   @unique @db.VarChar(50)
  name             String   @db.VarChar(100)
  credentialSchema Json?    @map("credential_schema")
  isEnabled        Boolean  @default(true) @map("is_enabled")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  statusMappings  PlatformStatusMapping[]
  channelAccounts ChannelAccount[]

  @@map("platforms")
}

model PlatformStatusMapping {
  id                Int              @id @default(autoincrement())
  platformId        Int              @map("platform_id")
  rawStatus         String           @map("raw_status") @db.VarChar(80)
  normalizedStatus  NormalizedStatus @map("normalized_status")
  affectsCommission Boolean          @default(true) @map("affects_commission")
  note              String?          @db.VarChar(255)

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, rawStatus])
  @@map("platform_status_mappings")
}

model ChannelAccount {
  id                 Int      @id @default(autoincrement())
  ownerUserId        Int      @map("owner_user_id")
  platformId         Int      @map("platform_id")
  externalChannelId  String   @default("") @map("external_channel_id") @db.VarChar(100)
  displayName        String   @map("display_name") @db.VarChar(255)
  affiliateAlias     String   @default("") @map("affiliate_alias") @db.VarChar(50)
  /** 结算报表 · 收款人（按渠道账号列展示） */
  settlementPayeeName    String @default("") @map("settlement_payee_name") @db.VarChar(120)
  /** 结算报表 · 收款卡号 */
  settlementBankAccount  String @default("") @map("settlement_bank_account") @db.VarChar(80)
  credentialsEnc     String   @map("credentials_enc") @db.Text
  isActive           Boolean  @default(true) @map("is_active")
  /** 绑定的内容站。为空表示沿用原有渠道账号，不参与自动发文。 */
  siteId             Int?     @map("site_id")
  paymentMethodId    Int?     @map("payment_method_id")
  /** 联盟跟踪链接前缀。空则按平台默认规则拼接 url 参数。 */
  trackLinkPrefix    String   @default("") @map("track_link_prefix") @db.VarChar(500)
  lastTestedAt       DateTime? @map("last_tested_at")
  lastTestOk         Boolean  @default(false) @map("last_test_ok")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  ownerUser     User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  platform      Platform          @relation(fields: [platformId], references: [id])
  site          PublishSite?      @relation(fields: [siteId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  orders       AffiliateOrder[]
  merchantClicks AffiliateMerchantClickDaily[]
  syncJobItems SyncJobItem[]

  @@unique([ownerUserId, platformId, externalChannelId])
  @@index([ownerUserId])
  @@index([platformId])
  @@map("channel_accounts")
}

model AffiliateOrder {
  id                Int              @id @default(autoincrement())
  channelAccountId  Int              @map("channel_account_id")
  externalOrderId   String           @map("external_order_id") @db.VarChar(255)
  merchantId        String?          @map("merchant_id") @db.VarChar(100)
  merchantName      String?          @map("merchant_name") @db.VarChar(255)
  merchantSlug      String?          @map("merchant_slug") @db.VarChar(100)
  productId         String?          @map("product_id") @db.VarChar(50)
  orderAmount       Decimal          @default(0) @map("order_amount") @db.Decimal(14, 2)
  commission        Decimal          @default(0) @db.Decimal(14, 2)
  currency          String           @default("USD") @db.VarChar(10)
  rawStatus         String?          @map("raw_status") @db.VarChar(80)
  normalizedStatus  NormalizedStatus @default(pending) @map("normalized_status")
  orderDate         DateTime         @map("order_date") @db.Date
  confirmDate       DateTime?        @map("confirm_date") @db.Date
  priceModel        String?          @map("price_model") @db.VarChar(20)
  rawPayload        Json?            @map("raw_payload")
  collectedAt       DateTime         @default(now()) @map("collected_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, externalOrderId])
  @@index([orderDate])
  @@index([merchantId])
  @@index([normalizedStatus])
  @@map("affiliate_orders")
}

/** PM click_report 按商家+日汇总（刷量/换链监控，与 Google Ads 点击分开） */
model AffiliateMerchantClickDaily {
  id               Int      @id @default(autoincrement())
  channelAccountId Int      @map("channel_account_id")
  merchantId       String   @map("merchant_id") @db.VarChar(100)
  merchantName     String   @default("") @map("merchant_name") @db.VarChar(255)
  clickDate        DateTime @map("click_date") @db.Date
  clicks           Int      @default(0)
  /** RW Performance 看板 Orders（Transaction Date 口径，与 transaction_details 行数无关） */
  performanceOrders Int     @default(0) @map("performance_orders")
  /** RW Performance 看板 Comm.（Transaction Date 口径，与 medium/performance 一致） */
  performanceCommission Decimal @default(0) @map("performance_commission") @db.Decimal(12, 2)
  /** api=采集写入；manual=校准导入（采集保留 clicks；导入含订单数时保留 orders） */
  source           AffiliateClickSource @default(api) @map("source")
  updatedAt        DateTime @updatedAt @map("updated_at")

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([channelAccountId, merchantId, clickDate])
  @@index([clickDate])
  @@map("affiliate_merchant_click_daily")
}

model SyncJob {
  id          Int           @id @default(autoincrement())
  ownerUserId Int           @map("owner_user_id")
  startDate   DateTime      @map("start_date") @db.Date
  endDate     DateTime      @map("end_date") @db.Date
  status      SyncJobStatus @default(pending)
  totalItems  Int           @default(0) @map("total_items")
  completed   Int           @default(0)
  failed      Int           @default(0)
  errorMessage String?      @map("error_message") @db.Text
  /** 是否同时拉取 PM 联盟点击（按小时 API，较慢） */
  includeClicks Boolean     @default(false) @map("include_clicks")
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  ownerUser User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  items     SyncJobItem[]

  @@index([ownerUserId])
  @@map("sync_jobs")
}

model SyncJobItem {
  id               Int               @id @default(autoincrement())
  syncJobId        Int               @map("sync_job_id")
  channelAccountId Int               @map("channel_account_id")
  status           SyncJobItemStatus @default(pending)
  ordersFetched    Int               @default(0) @map("orders_fetched")
  ordersInserted   Int               @default(0) @map("orders_inserted")
  ordersUpdated    Int               @default(0) @map("orders_updated")
  errorMessage     String?           @map("error_message") @db.Text
  startedAt        DateTime?         @map("started_at")
  completedAt      DateTime?         @map("completed_at")

  syncJob        SyncJob        @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@map("sync_job_items")
}

model AdDataSource {
  id          Int      @id @default(autoincrement())
  ownerUserId Int      @map("owner_user_id")
  name        String   @db.VarChar(255)
  sheetUrl    String   @map("sheet_url") @db.VarChar(500)
  sheetId     String   @map("sheet_id") @db.VarChar(100)
  mainTab     String   @default("raw_daily_report") @map("main_tab") @db.VarChar(100)
  description String?  @db.Text
  /** 最近一次 Sheet 导入涉及的 Google customerId，用于结算报表按 MCC 汇总广告费 */
  linkedCustomerIds Json @default("[]") @map("linked_customer_ids")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("ad_data_sources")
}

model AdCampaignDaily {
  id             Int      @id @default(autoincrement())
  ownerUserId    Int      @map("owner_user_id")
  date           DateTime @db.Date
  customerId     String   @map("customer_id") @db.VarChar(30)
  campaignId     String   @map("campaign_id") @db.VarChar(30)
  campaignName   String   @map("campaign_name") @db.VarChar(500)
  campaignStatus String   @default("") @map("campaign_status") @db.VarChar(20)
  affiliateAlias String   @default("") @map("affiliate_alias") @db.VarChar(50)
  merchantId     String   @default("") @map("merchant_id") @db.VarChar(100)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  cost           Decimal  @default(0) @db.Decimal(14, 4)
  campaignBudget Decimal  @default(0) @map("campaign_budget") @db.Decimal(14, 2)
  searchBudgetLostIs Decimal @default(0) @map("search_budget_lost_is") @db.Decimal(7, 4)
  searchRankLostIs   Decimal @default(0) @map("search_rank_lost_is") @db.Decimal(7, 4)
  avgCpc         Decimal  @default(0) @map("avg_cpc") @db.Decimal(14, 4)
  maxCpc         Decimal  @default(0) @map("max_cpc") @db.Decimal(14, 4)
  currency       String   @default("USD") @db.VarChar(10)
  /** sheet = 现有表格导入；google_ads_api = 以后的 API 日报。当前唯一键未包含 source，避免改动已有日报索引。 */
  source         String   @default("sheet") @db.VarChar(32)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, date, customerId, campaignId])
  @@index([ownerUserId, date])
  @@index([merchantId])
  @@map("ad_campaign_daily")
}

/** 账户月广告费（来自 monthly_account_cost，总广告费对账口径） */
model AdAccountMonthly {
  id           Int      @id @default(autoincrement())
  ownerUserId  Int      @map("owner_user_id")
  month        String   @db.VarChar(7)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  customerId   String   @map("customer_id") @db.VarChar(30)
  customerName String   @default("") @map("customer_name") @db.VarChar(255)
  currency     String   @default("USD") @db.VarChar(10)
  cost         Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, month, customerId])
  @@index([ownerUserId, month])
  @@map("ad_account_monthly")
}

/** 结算报表 · 实收佣金手工录入（按报表 scope + 月 + 联盟序号列） */
model SettlementActualCommission {
  id           Int      @id @default(autoincrement())
  scopeKey     String   @map("scope_key") @db.VarChar(32)
  month        String   @db.VarChar(7)
  affiliateKey String   @map("affiliate_key") @db.VarChar(80)
  /** 实收·上半月 (USD)，与下半月之和同步写入 amountUsd */
  amountUsdH1  Decimal  @default(0) @map("amount_usd_h1") @db.Decimal(14, 2)
  /** 实收·下半月 (USD) */
  amountUsdH2  Decimal  @default(0) @map("amount_usd_h2") @db.Decimal(14, 2)
  amountUsd    Decimal  @default(0) @map("amount_usd") @db.Decimal(14, 2)
  updatedById  Int?     @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([scopeKey, month, affiliateKey])
  @@index([scopeKey, month])
  @@map("settlement_actual_commissions")
}

/** 结算报表 · 应收佣金（各平台后台打款/在途，按 scope + 月 + 渠道账号列） */
model SettlementReceivableCommission {
  id           Int      @id @default(autoincrement())
  scopeKey     String   @map("scope_key") @db.VarChar(32)
  month        String   @db.VarChar(7)
  affiliateKey String   @map("affiliate_key") @db.VarChar(80)
  amountUsdH1  Decimal  @default(0) @map("amount_usd_h1") @db.Decimal(14, 2)
  amountUsdH2  Decimal  @default(0) @map("amount_usd_h2") @db.Decimal(14, 2)
  amountUsd    Decimal  @default(0) @map("amount_usd") @db.Decimal(14, 2)
  updatedById  Int?     @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([scopeKey, month, affiliateKey])
  @@index([scopeKey, month])
  @@map("settlement_receivable_commissions")
}

/** 结算报表 · 广告费手工调整（按 scope + 月 + 广告数据源） */
model SettlementAdSpendLine {
  id            Int      @id @default(autoincrement())
  scopeKey      String   @map("scope_key") @db.VarChar(32)
  month         String   @db.VarChar(7)
  adSourceId    Int      @map("ad_source_id")
  adjustmentUsd Decimal  @default(0) @map("adjustment_usd") @db.Decimal(14, 2)
  /** 结算采用的广告费（原币口径，与库内汇总同单位） */
  spendUsd      Decimal  @default(0) @map("spend_usd") @db.Decimal(14, 2)
  updatedById   Int?     @map("updated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([scopeKey, month, adSourceId])
  @@index([scopeKey, month])
  @@map("settlement_ad_spend_lines")
}

/** 结算报表 · 月度杂项（应返广告费等） */
model SettlementMonthlyMeta {
  id               Int      @id @default(autoincrement())
  scopeKey         String   @map("scope_key") @db.VarChar(32)
  month            String   @db.VarChar(7)
  rebateAdSpendUsd Decimal  @default(0) @map("rebate_ad_spend_usd") @db.Decimal(14, 2)
  updatedById      Int?     @map("updated_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([scopeKey, month])
  @@map("settlement_monthly_meta")
}

model CommissionAlertRule {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique @map("user_id")
  isEnabled               Boolean  @default(true) @map("is_enabled")
  windowDays              Int      @default(30) @map("window_days")
  rejectedAmountThreshold Decimal  @default(100) @map("rejected_amount_threshold") @db.Decimal(14, 2)
  rejectedRateThreshold   Decimal  @default(25) @map("rejected_rate_threshold") @db.Decimal(5, 2)
  minRejectedOrders       Int      @default(1) @map("min_rejected_orders")
  minOrdersForRate        Int      @default(1) @map("min_orders_for_rate")
  minRejectedForRate      Decimal  @default(1) @map("min_rejected_for_rate") @db.Decimal(14, 2)
  autoCheckOnSync         Boolean  @default(true) @map("auto_check_on_sync")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("commission_alert_rules")
}

model CommissionAlert {
  id                  Int                   @id @default(autoincrement())
  userId              Int                   @map("user_id")
  merchantId          String                @map("merchant_id") @db.VarChar(100)
  merchantName        String                @default("") @map("merchant_name") @db.VarChar(255)
  windowStart         DateTime              @map("window_start") @db.Date
  windowEnd           DateTime              @map("window_end") @db.Date
  totalCommission     Decimal               @map("total_commission") @db.Decimal(14, 2)
  rejectedCommission  Decimal               @map("rejected_commission") @db.Decimal(14, 2)
  pendingCommission   Decimal               @default(0) @map("pending_commission") @db.Decimal(14, 2)
  rejectedOrderCount  Int                   @default(0) @map("rejected_order_count")
  totalOrderCount     Int                   @default(0) @map("total_order_count")
  rejectionRate       Decimal               @map("rejection_rate") @db.Decimal(5, 2)
  severity            String                @default("warning") @db.VarChar(20)
  thresholdAmount     Decimal               @map("threshold_amount") @db.Decimal(14, 2)
  thresholdRate       Decimal               @map("threshold_rate") @db.Decimal(5, 2)
  triggerReason       String                @map("trigger_reason") @db.VarChar(500)
  status              CommissionAlertStatus @default(open)
  lastTriggeredAt     DateTime              @default(now()) @map("last_triggered_at")
  /** 用户确认时的失效指标快照，用于判断是否需要重新提醒 */
  ackedAt                 DateTime? @map("acked_at")
  ackedRejectedCommission Decimal?  @map("acked_rejected_commission") @db.Decimal(14, 2)
  ackedRejectedOrderCount Int?      @map("acked_rejected_order_count")
  ackedRejectionRate      Decimal?  @map("acked_rejection_rate") @db.Decimal(5, 2)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId, windowStart, windowEnd])
  @@index([userId, status])
  @@map("commission_alerts")
}

/// 文章自动发布的内容站，例如 Blivio、NexusBazaar。
model PublishSite {
  id          Int      @id @default(autoincrement())
  ownerUserId Int      @map("owner_user_id")
  name        String   @db.VarChar(120)
  domain      String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ownerUser       User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  channelAccounts ChannelAccount[]
  articles        Article[]

  @@unique([ownerUserId, domain])
  @@index([ownerUserId])
  @@map("publish_sites")
}

/// 渠道账号上的收款方式。与现有收款人姓名、卡号分开保存。
model PaymentMethod {
  id          Int      @id @default(autoincrement())
  ownerUserId Int      @map("owner_user_id")
  name        String   @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ownerUser       User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  channelAccounts ChannelAccount[]

  @@unique([ownerUserId, name])
  @@index([ownerUserId])
  @@map("payment_methods")
}

/// 测试连接的一次性凭证。只有绑定内容站时才要求消费它，原有创建接口不走这里。
model ChannelConnectionTest {
  id          Int      @id @default(autoincrement())
  ownerUserId Int      @map("owner_user_id")
  platformId  Int      @map("platform_id")
  tokenHash   String   @map("token_hash") @db.VarChar(64)
  ok          Boolean
  message     String   @db.VarChar(500)
  expiresAt   DateTime @map("expires_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([ownerUserId, platformId])
  @@map("channel_connection_tests")
}

/// 可领取的联盟商家。成人、禁止、违规不可进入投放。
model CatalogMerchant {
  id               Int      @id @default(autoincrement())
  ownerUserId      Int      @map("owner_user_id")
  channelAccountId Int      @map("channel_account_id")
  platformCode     String   @map("platform_code") @db.VarChar(50)
  mid              String   @db.VarChar(64)
  name             String   @db.VarChar(255)
  merchantUrl      String   @map("merchant_url") @db.VarChar(2048)
  countryCode      String   @default("US") @map("country_code") @db.VarChar(8)
  blockReason      String   @default("none") @map("block_reason") @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  ownerUser User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  adJobs    AdJob[]

  @@unique([ownerUserId, channelAccountId, mid])
  @@index([ownerUserId])
  @@map("catalog_merchants")
}

/// 一个 MCC 一条连接。刷新令牌可空，本期不调用 Google。
model GoogleAdsConnection {
  id              Int      @id @default(autoincrement())
  ownerUserId     Int      @map("owner_user_id")
  mccCustomerId   String   @map("mcc_customer_id") @db.VarChar(16)
  refreshTokenEnc String   @default("") @map("refresh_token_enc") @db.VarChar(2048)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  ownerUser User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  customers GoogleAdsCustomer[]

  @@unique([ownerUserId, mccCustomerId])
  @@map("google_ads_connections")
}

/// 子账户。可用性是系统自己的开关，Google 状态另记。
model GoogleAdsCustomer {
  id                   Int      @id @default(autoincrement())
  connectionId         Int      @map("connection_id")
  customerId           String   @map("customer_id") @db.VarChar(16)
  googleStatus         String   @default("ENABLED") @map("google_status") @db.VarChar(32)
  availability         String   @default("available") @db.VarChar(32)
  currencyCode         String   @default("USD") @map("currency_code") @db.VarChar(8)
  timeZone             String   @default("Asia/Shanghai") @map("time_zone") @db.VarChar(64)
  activeCampaignCount  Int      @default(0) @map("active_campaign_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  connection GoogleAdsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, customerId])
  @@map("google_ads_customers")
}

/// 从领取到确认发布的一条任务。队列消息只保存 id。
model AdJob {
  id               String   @id @default(cuid())
  ownerUserId      Int      @map("owner_user_id")
  catalogMerchantId Int     @map("catalog_merchant_id")
  channelAccountId Int      @map("channel_account_id")
  status           String   @default("PENDING") @db.VarChar(32)
  step             String   @default("COMPETITOR_CREATIVES") @db.VarChar(40)
  progress         Int      @default(0)
  progressMessage  String   @default("") @map("progress_message") @db.VarChar(255)
  mccCustomerId    String   @map("mcc_customer_id") @db.VarChar(16)
  customerId       String   @default("") @map("customer_id") @db.VarChar(16)
  campaignName     String   @default("") @map("campaign_name") @db.VarChar(255)
  targetCountry    String   @map("target_country") @db.VarChar(8)
  languageCode     String   @default("") @map("language_code") @db.VarChar(16)
  idempotencyKey   String   @default("") @map("idempotency_key") @db.VarChar(191)
  input            Json
  draft            Json?
  errorMessage     String?  @map("error_message") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  ownerUser       User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  catalogMerchant CatalogMerchant        @relation(fields: [catalogMerchantId], references: [id])
  events          AdJobEvent[]
  article         Article?
  campaign        AdAutomationCampaign?

  @@index([ownerUserId, status])
  @@index([ownerUserId, idempotencyKey])
  @@map("ad_jobs")
}

model AdJobEvent {
  id        Int      @id @default(autoincrement())
  jobId     String   @map("job_id")
  status    String   @db.VarChar(32)
  step      String   @db.VarChar(40)
  message   String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  job AdJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("ad_job_events")
}

/// 发到内容站的文章。articleUrl 与广告最终到达网址不是同一个字段。
model Article {
  id                Int      @id @default(autoincrement())
  ownerUserId       Int      @map("owner_user_id")
  siteId            Int      @map("site_id")
  adJobId           String   @unique @map("ad_job_id")
  title             String   @db.VarChar(255)
  body              String   @db.Text
  trackUrl          String   @map("track_url") @db.VarChar(2048)
  merchantUrl       String   @map("merchant_url") @db.VarChar(2048)
  articleUrl        String   @default("") @map("article_url") @db.VarChar(2048)
  publishStatus     String   @default("pending_site") @map("publish_status") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  site PublishSite @relation(fields: [siteId], references: [id])
  job  AdJob       @relation(fields: [adJobId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("articles")
}

/// 本地广告系列。状态停留在待提交，不表示 Google 已启用。
model AdAutomationCampaign {
  id                  Int      @id @default(autoincrement())
  ownerUserId         Int      @map("owner_user_id")
  jobId               String   @unique @map("job_id")
  customerId          String   @map("customer_id") @db.VarChar(16)
  mccCustomerId       String   @map("mcc_customer_id") @db.VarChar(16)
  campaignName        String   @map("campaign_name") @db.VarChar(255)
  merchantUrl         String   @map("merchant_url") @db.VarChar(2048)
  finalUrlSuffix      String   @default("") @map("final_url_suffix") @db.VarChar(2048)
  status              String   @default("WAITING_SUBMIT") @db.VarChar(32)
  dailyBudgetMicros   BigInt   @map("daily_budget_micros")
  bidding             String   @db.VarChar(32)
  cpcBidCeilingMicros BigInt   @map("cpc_bid_ceiling_micros")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  ownerUser User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  job       AdJob       @relation(fields: [jobId], references: [id])
  outbox    AdsOutbox[]

  @@index([ownerUserId, status])
  @@map("ad_automation_campaigns")
}

/// 将来发给 Google Ads API 的请求。本期只保存，不发送。
model AdsOutbox {
  id         Int      @id @default(autoincrement())
  ownerUserId Int     @map("owner_user_id")
  campaignId Int      @map("campaign_id")
  kind       String   @db.VarChar(32)
  status     String   @default("HELD") @db.VarChar(16)
  payload    Json
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at")

  campaign AdAutomationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("ads_outbox")
}
